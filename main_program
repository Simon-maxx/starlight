<style>
:root{--bg:#fdfaf3;--surface:#ffffff;--surface2:#f3ede0;--ink:#172322;--muted:#5b6b68;--line:#e6ddcb;--teal:#0e4f4a;--amber:#c47a12;--amber-bg:#fdf0d5;--green:#178a4c;--green-bg:#e6f4ea;--radius:18px;--shadow:0 10px 30px rgba(20,40,38,.08);--navy:#131a33;--navy2:#1e2a52;--star:#f5c542;--star-soft:#fff3c4}
@media (prefers-color-scheme: dark){:root{--bg:#0d1220;--surface:#161e33;--surface2:#1e2a46;--ink:#eef1ff;--muted:#a9b4d6;--line:#2c3a5e;--teal:#7dd3c8;--amber:#f5c542;--amber-bg:#332b0f;--green-bg:#143324;--shadow:0 10px 30px rgba(0,0,0,.4);--navy:#0a0f1e;--navy2:#131f3d}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Sans SC",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.65}
a{color:var(--teal);text-decoration:none}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
header{position:sticky;top:0;z-index:20;background:color-mix(in srgb, var(--bg) 88%, transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;flex-wrap:wrap}
.brand{font-family:"Noto Serif SC",serif;font-weight:900;font-size:19px;color:var(--ink);line-height:1.2;display:flex;align-items:center;gap:10px}
.brand-star{width:36px;height:36px;border-radius:10px;background:var(--navy);color:var(--star);display:grid;place-items:center;font-size:20px;flex-shrink:0;box-shadow:0 4px 14px rgba(19,26,51,.25)}
.brand small{display:block;font-family:"Noto Sans SC",sans-serif;font-weight:500;font-size:11px;letter-spacing:.06em;color:var(--muted);text-transform:uppercase}
.brand-name{line-height:1.15}
.nav-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.navlinks{display:flex;gap:4px;flex-wrap:wrap;align-items:center}
.navlinks a{color:var(--ink);font-size:14px;font-weight:600;padding:9px 11px;border-radius:999px;min-height:36px;display:inline-flex;align-items:center}
.navlinks a:hover{background:var(--surface2)}
.navlinks a.cta{background:var(--teal);color:#fff}
@media(prefers-color-scheme:dark){.navlinks a.cta{color:#0b1514}}
.lang-switch{display:flex;background:var(--surface);border:1.5px solid var(--line);border-radius:999px;padding:3px;gap:2px}
.lang-btn{border:0;background:transparent;color:var(--muted);font-weight:800;font-size:13px;padding:7px 12px;border-radius:999px;cursor:pointer;min-height:34px;font-family:inherit}
.lang-btn.active{background:var(--teal);color:#fff}
@media(prefers-color-scheme:dark){.lang-btn.active{color:#0b1514}}
.hero{padding:36px 0 28px;position:relative}
.hero::before{content:"✦  ·  ✦   ·    ✦";position:absolute;top:6px;right:8px;color:var(--amber);opacity:.55;letter-spacing:.6em;font-size:13px;pointer-events:none}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;align-items:center}
.hero-eyebrow{display:inline-flex;align-items:center;gap:7px;background:var(--navy);color:#fff;font-size:13px;font-weight:700;letter-spacing:.04em;padding:7px 12px;border-radius:999px;margin-bottom:14px}
.hero-eyebrow b{color:var(--star);font-weight:900}
.mission-band{margin:6px 0 0;background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 100%);color:#eef1ff;border-radius:20px;padding:26px 24px;position:relative;overflow:hidden}
.mission-band::after{content:"✦ ✦  ·  ✦";position:absolute;top:14px;right:18px;color:var(--star);opacity:.7;letter-spacing:.5em;font-size:12px}
.mission-band h2{color:#fff;font-family:"Noto Serif SC",serif}
.mission-band p{color:#cbd5ff;max-width:820px}
.mission-quote{font-family:"Noto Serif SC",serif;font-size:20px;line-height:1.6;color:#fff;margin:10px 0 12px;max-width:820px}
.mission-quote em{color:var(--star);font-style:normal}
.mission-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}
@media(max-width:800px){.mission-grid{grid-template-columns:1fr}}
.mission-item{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:16px}
.mission-item h3{color:#fff;margin:0 0 6px;font-size:16px}
.mission-item p{margin:0;font-size:14px;color:#cbd5ff}
@media(max-width:860px){.hero-grid{grid-template-columns:1fr}}
h1{font-family:"Noto Serif SC",serif;font-size:42px;line-height:1.15;margin:0 0 14px;font-weight:900}
@media(max-width:560px){h1{font-size:32px}}
.lead{font-size:17px;color:var(--muted);margin:0 0 18px}
.pills{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
.pill{border:1.5px solid var(--teal);color:var(--teal);font-weight:800;font-size:14px;padding:7px 13px;border-radius:999px;background:var(--surface)}
.pill span{color:var(--amber);font-weight:900}
.hero-img{width:100%;border-radius:22px;display:block;box-shadow:var(--shadow);aspect-ratio:4/3;object-fit:cover}
.hero-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:18px;margin-top:16px;box-shadow:var(--shadow)}
.hero-card strong{color:var(--teal)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 22px;border-radius:999px;font-weight:800;font-size:15px;border:0;cursor:pointer;font-family:inherit}
.btn-primary{background:var(--teal);color:#fff}
@media(prefers-color-scheme:dark){.btn-primary{color:#0b1514}}
.btn-ghost{background:var(--surface);color:var(--ink);border:1.5px solid var(--line)}
.btn-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}
section{padding:34px 0}
h2{font-family:"Noto Serif SC",serif;font-size:28px;margin:0 0 8px;line-height:1.25}
.sub{color:var(--muted);margin:0 0 22px;max-width:760px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:900px){.grid4{grid-template-columns:1fr 1fr}.grid3{grid-template-columns:1fr}}
@media(max-width:560px){.grid4,.grid2{grid-template-columns:1fr}}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow)}
.card h3{margin:0 0 6px;font-size:18px}.card p{margin:0;color:var(--muted);font-size:14.5px}
.subject-icon{width:48px;height:48px;border-radius:13px;display:grid;place-items:center;font-size:24px;margin-bottom:12px;background:var(--amber-bg)}
.teacher-top{display:flex;gap:14px;align-items:center;margin-bottom:12px}
.avatar{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:900;font-size:24px;flex-shrink:0}
.av-s{background:#0e4f4a}.av-i{background:#8a5a12}.av-j{background:#315e8a}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin:12px 0}
.tag{font-size:12.5px;font-weight:700;background:var(--surface2);border:1px solid var(--line);padding:4px 9px;border-radius:999px}
.avail{font-size:13.5px;background:var(--green-bg);color:var(--green);font-weight:700;border-radius:10px;padding:9px 11px}
@media(prefers-color-scheme:dark){.avail{color:#7ddba3}}
.teacher-filter{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.tfilter{border:1.5px solid var(--line);background:var(--surface);color:var(--ink);padding:10px 18px;border-radius:999px;font-weight:800;cursor:pointer;min-height:44px;font-size:14.5px;font-family:inherit}
.tfilter.active{background:var(--teal);color:#fff;border-color:var(--teal)}
@media(prefers-color-scheme:dark){.tfilter.active{color:#0b1514}}
.schedule{display:grid;grid-template-columns:repeat(7,1fr);gap:10px}
@media(max-width:1000px){.schedule{grid-template-columns:repeat(3,1fr)}}
@media(max-width:640px){.schedule{grid-template-columns:1fr 1fr}}
@media(max-width:420px){.schedule{grid-template-columns:1fr}}
.day{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px}
.day.today{border-color:var(--amber);border-width:2px}
.day h4{margin:0;font-size:14px}.day .date{font-size:12px;color:var(--muted);margin-bottom:10px}
.day .off{font-size:12.5px;color:var(--muted);background:var(--surface2);border-radius:8px;padding:7px;text-align:center;margin-bottom:8px}
.slot{display:block;width:100%;text-align:center;padding:9px 4px;margin-bottom:7px;border-radius:9px;border:1.5px solid #bfe3d2;background:var(--green-bg);color:var(--green);font-weight:800;font-size:13.5px;cursor:pointer;min-height:40px;font-family:inherit}
@media(prefers-color-scheme:dark){.slot{color:#7ddba3}}
.slot:hover{border-color:var(--green)}.slot.selected{background:var(--teal);color:#fff;border-color:var(--teal)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-top:14px}
.dot{display:inline-block;width:11px;height:11px;border-radius:3px;vertical-align:-1px;margin-right:5px}
form{display:grid;gap:14px}
label{font-weight:700;font-size:14px;display:block;margin-bottom:6px}
input,select,textarea{width:100%;padding:12px 13px;border:1.5px solid var(--line);border-radius:11px;background:var(--surface);color:var(--ink);font:inherit;font-size:15px;min-height:48px}
textarea{min-height:96px;resize:vertical}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:640px){.frow{grid-template-columns:1fr}}
.hint{font-size:13px;color:var(--muted);margin-top:6px}
.success{display:none;background:var(--green-bg);border:1px solid #bfe3d2;border-radius:12px;padding:14px;font-size:14.5px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
@media(max-width:800px){.steps{grid-template-columns:1fr}}
.step-num{width:34px;height:34px;border-radius:50%;background:var(--teal);color:#fff;display:grid;place-items:center;font-weight:900;margin-bottom:10px}
@media(prefers-color-scheme:dark){.step-num{color:#0b1514}}
footer{border-top:1px solid var(--line);padding:28px 0 40px;color:var(--muted);font-size:14px}
.scope-bar{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.scope-chip{background:var(--amber-bg);color:var(--ink);font-size:13px;font-weight:700;padding:6px 11px;border-radius:999px}
@media(max-width:640px){.brand{font-size:16px}.brand small{font-size:10px}.navlinks a{padding:8px 8px;font-size:13px}.nav{gap:8px}}
/* === STARLIGHT THEME — deep night sky + warm starlight === */
:root{--bg:#f1eff9;--surface:#ffffff;--surface2:#e8e5f3;--ink:#131a33;--muted:#4f587c;--line:#d9d4ec;--teal:#1e2a52;--amber:#b97f06;--amber-bg:#fef3c7;--green:#14713e;--green-bg:#e2f3e6;--navy:#0f1730;--navy2:#232f5e;--star:#f5c542;--star-soft:#fff3c4}
@media(prefers-color-scheme:dark){:root{--bg:#070c1a;--surface:#121a30;--surface2:#1a2542;--ink:#eef1ff;--muted:#a9b4d6;--line:#2a365e;--teal:#f5c542;--amber:#f5c542;--amber-bg:#2a2410;--green:#7ddba3;--green-bg:#122e20}}
body{background-image:radial-gradient(rgba(245,197,66,.22) 1px,transparent 1.2px),radial-gradient(rgba(35,47,94,.12) 1px,transparent 1.2px);background-size:84px 84px,52px 52px;background-position:0 0,26px 38px}
header{background:var(--navy);border-bottom:2px solid rgba(245,197,66,.45);backdrop-filter:none}
header .brand,header .brand-name,header .navlinks a{color:#fff}
header .brand small{color:#cbd5ff}
header .navlinks a:hover{background:rgba(255,255,255,.12)}
header .navlinks a.cta{background:var(--star);color:#131a33}
.lang-switch{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.25)}
.lang-btn{color:#cbd5ff}.lang-btn.active{background:var(--star);color:#131a33}
.hero{background:linear-gradient(145deg,#0f1730 0%,#1e2a52 58%,#2d3a6e 100%);border-radius:26px;padding:34px 28px 30px;margin-top:18px;color:#fff;box-shadow:0 18px 44px rgba(15,23,48,.28);overflow:hidden}
.hero h1{color:#fff}.hero h1::after{content:" ✦";color:var(--star);font-size:.55em;vertical-align:super}
.hero .lead{color:#d6dcff}
.hero .pill{background:rgba(255,255,255,.08);border-color:rgba(245,197,66,.75);color:#fff}
.hero .pill span{color:var(--star)}
.hero .scope-chip{background:rgba(245,197,66,.18);color:#ffe9a8;border:1px solid rgba(245,197,66,.35)}
.hero-card{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.18);color:#eef1ff;box-shadow:none}
.hero-card strong{color:var(--star)}
.hero-card span{color:#d6dcff!important}
.btn-primary{background:var(--star);color:#131a33;box-shadow:0 6px 18px rgba(245,197,66,.28)}
.btn-primary:hover{filter:brightness(1.06)}
.hero .btn-ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.45)}
.btn-ghost{background:var(--surface);color:var(--ink)}
h2::before{content:"✦ ";color:var(--amber);font-size:.82em}
.mission-band h2::before{content:""}
.card{border-color:var(--line);box-shadow:0 10px 28px rgba(15,23,48,.09)}
.subject-icon{background:var(--navy);color:var(--star);font-size:22px}
.av-s{background:linear-gradient(135deg,#1e2a52,#3b4f9a)}.av-i{background:linear-gradient(135deg,#8a5f08,#d99a12)}.av-j{background:linear-gradient(135deg,#1f4d6e,#2f7aa6)}
.step-num{background:var(--navy);color:var(--star)}
.tfilter.active,.slot.selected{background:var(--navy);color:var(--star);border-color:var(--navy)}
.slot{border-color:#e3c86a;background:#fff8db;color:#6b5200}
@media(prefers-color-scheme:dark){.slot{background:#2a2410;color:#ffe9a8;border-color:#6b5a1f}.slot.selected{background:var(--star);color:#131a33;border-color:var(--star)}}
.day.today{border-color:var(--star);box-shadow:0 0 0 1px var(--star)}
footer{background:var(--navy);color:#cbd5ff;border-top:2px solid rgba(245,197,66,.45);margin-top:10px}
.mission-story{background:rgba(245,197,66,.12);border:1px solid rgba(245,197,66,.35);border-radius:14px;padding:16px 18px;margin-top:16px;color:#ffeec2!important;font-size:15px;line-height:1.7}
</style>
