function t(k){return I18N[currentLang][k]||I18N.zh[k]||k;}
function setLang(lang){
  currentLang=lang;
  document.documentElement.lang=lang==="zh"?"zh-CN":(lang==="fr"?"fr":"en");
  var btns=document.querySelectorAll(".lang-btn");
  for(var i=0;i<btns.length;i++) btns[i].classList.toggle("active",btns[i].getAttribute("data-lang")===lang);
  var els=document.querySelectorAll("[data-i18n]");
  for(var j=0;j<els.length;j++){var key=els[j].getAttribute("data-i18n"); if(I18N[lang][key]!==undefined) els[j].innerHTML=I18N[lang][key];}
  var phs=document.querySelectorAll("[data-i18n-ph]");
  for(var k=0;k<phs.length;k++){var pk=phs[k].getAttribute("data-i18n-ph"); if(I18N[lang][pk]!==undefined) phs[k].setAttribute("placeholder",I18N[lang][pk]);}
  var opts=document.querySelectorAll("[data-i18n-opt]");
  for(var m=0;m<opts.length;m++){var ok=opts[m].getAttribute("data-i18n-opt"); if(I18N[lang][ok]!==undefined){opts[m].textContent=I18N[lang][ok]; opts[m].value=I18N[lang][ok];}}
  document.getElementById("optNoPref").textContent=t("no_pref");
  var subjSel=document.getElementById("fSubject");
  for(var s=0;s<subjSel.options.length;s++) subjSel.options[s].textContent=t("subj_opts")[s];
  var subjQ=lang==="fr"?"[Starlight Academy] Question sur les cours de tutorat en sciences":(lang==="en"?"[Starlight Academy] Question about science tutoring":"[Starlight Academy 星光学堂] 咨询理科辅导课程");
  document.getElementById("contactMailBtn").href="mailto:"+EMAIL+"?subject="+encodeURIComponent(subjQ);
  updateTimeOptions(); renderSchedule();
}
function fmtDate(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
function isWeekend(d){var g=d.getDay(); return g===0||g===6;}
function fmtDayLabel(d){ if(currentLang==="zh") return (d.getMonth()+1)+"月"+d.getDate()+"日"; if(currentLang==="fr") return d.getDate()+" "+t("months")[d.getMonth()]; return t("months")[d.getMonth()]+" "+d.getDate(); }
function renderSchedule(){
  var grid=document.getElementById("scheduleGrid"); if(!grid) return; grid.innerHTML="";
  var today=new Date(); today.setHours(0,0,0,0);
  for(var i=0;i<7;i++){
    var d=new Date(today); d.setDate(d.getDate()+i);
    var we=isWeekend(d); var slots=we?WEEKEND_SLOTS:WEEKDAY_SLOTS;
    var day=document.createElement("div"); day.className="day"+(i===0?" today":"");
    var html="<h4>"+t("wd")[d.getDay()]+(i===0?t("today"):"")+"</h4><div class='date'>"+fmtDayLabel(d)+" · "+currentTeacher+"</div>";
    if(!we) html+="<div class='off'>"+t("off_label")+"</div>";
    day.innerHTML=html;
    slots.forEach(function(tm){
      var b=document.createElement("button"); b.className="slot"; b.type="button"; b.textContent=tm;
      var ds=fmtDate(d);
      if(selectedSlot&&selectedSlot.dateStr===ds&&selectedSlot.time===tm) b.classList.add("selected");
      b.onclick=(function(dateStr,time){return function(){ selectedSlot={dateStr:dateStr,time:time}; document.getElementById("fTeacher").value=currentTeacher; document.getElementById("fDate").value=dateStr; updateTimeOptions(); document.getElementById("fTime").value=time; renderSchedule(); document.getElementById("book").scrollIntoView({behavior:"smooth"}); };})(ds,tm);
      day.appendChild(b);
    });
    grid.appendChild(day);
  }
}
function setTeacher(name,el){ currentTeacher=name; var btns=document.querySelectorAll(".tfilter"); for(var i=0;i<btns.length;i++) btns[i].classList.toggle("active",btns[i].getAttribute("data-teacher")===name); document.getElementById("fTeacher").value=name; renderSchedule(); }
function pickTeacher(name){ setTeacher(name,null); document.getElementById("fTeacher").value=name; document.getElementById("schedule").scrollIntoView({behavior:"smooth"}); }
function updateTimeOptions(){
  var dateVal=document.getElementById("fDate").value; var sel=document.getElementById("fTime"); var hint=document.getElementById("timeHint"); var prev=sel.value; sel.innerHTML="";
  if(!dateVal){hint.textContent=t("time_hint_nodate"); return;}
  var parts=dateVal.split("-"); var d=new Date(parseInt(parts[0]),parseInt(parts[1])-1,parseInt(parts[2])); var we=isWeekend(d); var slots=we?WEEKEND_SLOTS:WEEKDAY_SLOTS;
  slots.forEach(function(tm){var o=document.createElement("option"); o.value=tm; o.textContent=tm+" – "+(parseInt(tm.split(":")[0])+1)+":00"; sel.appendChild(o);});
  if(prev&&slots.indexOf(prev)>=0) sel.value=prev;
  hint.textContent=we?t("time_hint_weekend"):t("time_hint_weekday");
}
function selectedText(sel){return sel.options[sel.selectedIndex]?sel.options[sel.selectedIndex].textContent:sel.value;}
function bookingText(){
  var name=document.getElementById("fName").value.trim(); var contact=document.getElementById("fContact").value.trim();
  var teacherSel=document.getElementById("fTeacher"); var teacher=teacherSel.value==="No preference"?t("no_pref"):teacherSel.value;
  var subject=selectedText(document.getElementById("fSubject")); var level=selectedText(document.getElementById("fLevel")); var mode=selectedText(document.getElementById("fMode"));
  var date=document.getElementById("fDate").value; var time=document.getElementById("fTime").value; var note=document.getElementById("fNote").value.trim();
  var dateLabel=date; if(date){var p=date.split("-"); var d=new Date(parseInt(p[0]),parseInt(p[1])-1,parseInt(p[2])); dateLabel=date+" ("+t("wd")[d.getDay()]+")";}
  var L=t("email_labels"); var sep=currentLang==="zh"?"：":": ";
  var body=t("email_greeting")+"\n\n"+L[0]+sep+name+"\n"+L[1]+sep+contact+"\n"+L[2]+sep+teacher+"\n"+L[3]+sep+subject+"\n"+L[4]+sep+level+"\n"+L[5]+sep+dateLabel+"\n"+L[6]+sep+time+t("email_duration")+"\n"+L[7]+sep+mode+"\n"+L[8]+sep+(note||t("email_none"))+"\n\n"+t("email_end");
  return {name:name,teacher:teacher,subject:subject,body:body};
}
document.getElementById("fDate").addEventListener("change",updateTimeOptions);
document.getElementById("bookForm").addEventListener("submit",function(e){
  e.preventDefault(); var b=bookingText(); if(!b.name){document.getElementById("fName").focus(); return;}
  var prefix=currentLang==="fr"?"[Réservation] ":(currentLang==="en"?"[Booking] ":"[预约] ");
  var subject=encodeURIComponent(prefix+b.subject+" · "+b.teacher+" · "+document.getElementById("fDate").value+" "+document.getElementById("fTime").value);
  var body=encodeURIComponent(b.body); var box=document.getElementById("successBox"); box.innerHTML=t("success_html"); box.style.display="block";
  var a=document.createElement("a"); a.href="mailto:"+EMAIL+"?subject="+subject+"&body="+body; document.body.appendChild(a); a.click(); a.remove();
});
function copyBooking(){
  var b=bookingText(); var prefix=currentLang==="fr"?"[Réservation] ":(currentLang==="en"?"[Booking] ":"[预约] ");
  var text=t("copy_to")+": "+EMAIL+"\n"+t("copy_subject")+": "+prefix+b.subject+" · "+b.teacher+"\n\n"+b.body;
  if(navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(text).then(function(){ var box=document.getElementById("successBox"); box.style.display="block"; box.innerHTML=t("copied_html"); }); }
}
(function(){
  var today=new Date(); var tmr=new Date(); tmr.setDate(tmr.getDate()+1);
  var di=document.getElementById("fDate"); di.min=fmtDate(today); di.value=fmtDate(tmr);
  var lv=document.getElementById("fLevel"); for(var i=0;i<lv.options.length;i++) lv.options[i].value=lv.options[i].textContent;
  var md=document.getElementById("fMode"); for(var j=0;j<md.options.length;j++) md.options[j].value=md.options[j].textContent;
  updateTimeOptions(); renderSchedule();
})();
</script>
