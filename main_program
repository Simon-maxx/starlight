<body>
<header><div class="wrap nav">
  <a class="brand" href="#top"><span class="brand-star" aria-hidden="true">✦</span><span class="brand-name"><span data-i18n="brand_name">Starlight Academy · 星光学堂</span><small data-i18n="brand_sub">点点星光做引 · Science Tutoring · Canada &amp; Worldwide</small></span></a>
  <div class="nav-right">
    <nav class="navlinks">
      <a href="#philosophy" data-i18n="nav_philosophy">创始初心</a>
